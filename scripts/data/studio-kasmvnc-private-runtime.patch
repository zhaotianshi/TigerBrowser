diff --git a/common/network/PrivateSocket.h b/common/network/PrivateSocket.h
new file mode 100644
index 0000000..e3ad879
--- /dev/null
+++ b/common/network/PrivateSocket.h
@@ -0,0 +1,23 @@
+/* Studio uses a private /tmp mount for each display.
+ * Keep this IPC in that mount when PID namespaces reuse process numbers.
+ * This modification is distributed under KasmVNC's GPL-2.0-or-later license.
+ */
+#ifndef KASMVNC_PRIVATE_SOCKET_H
+#define KASMVNC_PRIVATE_SOCKET_H
+
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+
+static inline socklen_t kasm_private_socket_address(struct sockaddr_un *addr,
+                                                   unsigned int pid)
+{
+    memset(addr, 0, sizeof(*addr));
+    addr->sun_family = AF_UNIX;
+    snprintf(addr->sun_path, sizeof(addr->sun_path), "/tmp/.KasmVNCSock%u", pid);
+    return offsetof(struct sockaddr_un, sun_path) + strlen(addr->sun_path) + 1;
+}
+
+#endif
